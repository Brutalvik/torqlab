{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist-server",
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "src/data.ts"],
  "exclude": ["server/**/*.test.ts"]
}
